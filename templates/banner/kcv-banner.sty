% kcv-banner.sty
% Single-column layout with a coloured banner at the top (photo, name, job title, contacts) and a
% timeline body: dates in a left column, entries on the right. Sober and readable, pdfLaTeX,
% Source Sans font.
% Content (name, experience...) never lives here: see TEMPLATE.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kcv-banner}[2026/10/18 kcv banner]

\RequirePackage[a4paper, top=0.9 cm, bottom=0.8 cm, left=1.3 cm, right=1.3 cm]{geometry}
\RequirePackage[dvipsnames]{xcolor}
\definecolor{accentColor}{RGB}{31, 58, 95}     % navy
\definecolor{softColor}{RGB}{196, 214, 236}    % light blue, on the banner
\definecolor{mutedColor}{RGB}{95, 102, 112}    % secondary text
\definecolor{ruleColor}{RGB}{190, 200, 214}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{fontawesome5}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{ifthen}
\RequirePackage{iftex}
\RequirePackage[colorlinks=true, urlcolor=white, linkcolor=black]{hyperref}
\RequirePackage{bookmark}

% PDF readable by applicant tracking systems (ATS)
\ifPDFTeX
  \input{glyphtounicode}
  \pdfgentounicode=1
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\fi
\RequirePackage[default]{sourcesanspro}

\pagestyle{empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% Width of the left (dates) column of the timeline.
\newlength{\cv@datewidth}\setlength{\cv@datewidth}{3.3 cm}

% Sections: navy uppercase title, light rule.
\titleformat{\section}{\color{accentColor}\large\bfseries}{}{0pt}{\MakeUppercase}%
  [{\color{ruleColor}\vspace{1pt}\titlerule[0.8pt]}]
\titlespacing{\section}{0pt}{0.3 cm}{0.12 cm}

% ---------------------------------------------------------------------------
% Content macros: the only ones cv.tex should use.
% ---------------------------------------------------------------------------

% Optional lines, called before \cvheader: \cvsubname{née NAME}, \cvheadline{job title}
\def\cv@subname{}\def\cv@headline{}
\newcommand{\cvsubname}[1]{\def\cv@subname{#1}}
\newcommand{\cvheadline}[1]{\def\cv@headline{#1}}

% \cvheader{photo or empty}{First LAST}{contacts separated by \cvsep}
\newlength{\cv@bannerheight}\setlength{\cv@bannerheight}{4.3 cm}
\newcommand{\cvsep}{\hspace{0.45 cm}}
\newcommand{\cvheader}[3]{%
  \hypersetup{pdftitle={CV - #2}, pdfauthor={#2}}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[accentColor] (current page.north west) rectangle
      ([yshift=-\cv@bannerheight]current page.north east);
    \ifthenelse{\equal{#1}{}}{%
      \coordinate (text) at ([xshift=1.3 cm, yshift=-0.5\cv@bannerheight]current page.north west);
    }{%
      \begin{scope}
        \clip ([xshift=2.9 cm, yshift=-0.5\cv@bannerheight]current page.north west) circle (1.6 cm);
        \node at ([xshift=2.9 cm, yshift=-0.5\cv@bannerheight]current page.north west)
          {\includegraphics[width=3.2 cm]{#1}};
      \end{scope}
      \draw[white, line width=1.5pt]
        ([xshift=2.9 cm, yshift=-0.5\cv@bannerheight]current page.north west) circle (1.6 cm);
      \coordinate (text) at ([xshift=5.2 cm, yshift=-0.5\cv@bannerheight]current page.north west);
    }
    \node[anchor=west, text width=14.5 cm, align=left, inner sep=0pt, white] at (text) {%
      {\fontsize{24 pt}{26 pt}\selectfont\bfseries #2}\par
      \ifx\cv@subname\@empty\else\vspace{2pt}{\large\color{softColor}\cv@subname}\par\fi
      \ifx\cv@headline\@empty\else\vspace{4pt}{\large\bfseries\cv@headline}\par\fi
      \vspace{8pt}{\small\color{white}#3}};
  \end{tikzpicture}%
  \vspace*{\dimexpr\cv@bannerheight-1.35 cm\relax}\par
}

% Contacts (on the banner): \cvlocation{City}, \cvmail{address}, \cvphone{+33...}{displayed},
% \cvlink{fontawesome icon}{url}{displayed}, \cvinfo{icon}{text}
\newcommand{\cv@icon}[1]{{\color{softColor}\csname fa#1\endcsname}\hspace*{0.13 cm}}
\newcommand{\cvlocation}[1]{\mbox{\cv@icon{MapMarker}#1}}
\newcommand{\cvmail}[1]{\mbox{\href{mailto:#1}{\cv@icon{Envelope}#1}}}
\newcommand{\cvphone}[2]{\mbox{\href{tel:#1}{\cv@icon{Phone}#2}}}
\newcommand{\cvlink}[3]{\mbox{\href{#2}{\cv@icon{#1}#3}}}
\newcommand{\cvinfo}[2]{\mbox{\cv@icon{#1}#2}}

\newcommand{\cvtext}[1]{#1\par}

% \cventry{Title}{Subtitle or empty}{Organization}{Location}{Dates}
% optionally followed by a cvpoints environment.
\newcommand{\cventry}[5]{%
  \vspace{0.06 cm}%
  \begin{tabularx}{\linewidth}{@{}p{\cv@datewidth}@{\hspace{0.5 cm}}X@{}}
    \textcolor{accentColor}{\small\bfseries #5} &
    \textbf{#1}%
    \ifthenelse{\equal{#2}{}}{}{\newline #2}%
    \ifthenelse{\equal{#3#4}{}}{}{\newline{\small\itshape #3}%
      \ifthenelse{\equal{#3}{}\OR\equal{#4}{}}{}{\small\ \textperiodcentered\ }%
      {\small\color{mutedColor}#4}}\\
  \end{tabularx}\par}
\newenvironment{cvpoints}{%
  \begin{itemize}[leftmargin=\dimexpr\cv@datewidth+0.9 cm\relax,
    label={\color{accentColor}\textbullet}, topsep=1pt, itemsep=0pt, parsep=0pt]\small
}{\end{itemize}}

% Skill line, aligned on the timeline: \cvskill{Category}{list}
\newcommand{\cvskill}[2]{%
  \vspace{0.08 cm}%
  \begin{tabularx}{\linewidth}{@{}p{\cv@datewidth}@{\hspace{0.5 cm}}X@{}}
    \textcolor{accentColor}{\small\bfseries #1} & #2\\
  \end{tabularx}\par}

\endinput
