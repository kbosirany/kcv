% kcv-sidebar.sty
% Two-column layout: a tinted sidebar on the left (photo, contact, skills) and the main column on
% the right (name, summary, experience, education). Sober and readable, pdfLaTeX, Lato font.
% Content (name, experience...) never lives here: see TEMPLATE.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kcv-sidebar}[2026/10/18 kcv sidebar]

\RequirePackage[a4paper, top=1.1 cm, bottom=0.9 cm, left=0.7 cm, right=0.9 cm]{geometry}
\RequirePackage[dvipsnames]{xcolor}
\definecolor{accentColor}{RGB}{38, 104, 100}  % deep teal
\definecolor{sideColor}{RGB}{233, 242, 240}   % sidebar tint
\definecolor{mutedColor}{RGB}{95, 105, 110}   % secondary text
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{fontawesome5}
\RequirePackage{paracol}
\RequirePackage{eso-pic}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{ifthen}
\RequirePackage{iftex}
\RequirePackage[colorlinks=true, urlcolor=black, linkcolor=black]{hyperref}
\RequirePackage{bookmark}

% PDF readable by applicant tracking systems (ATS)
\ifPDFTeX
  \input{glyphtounicode}
  \pdfgentounicode=1
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\fi
\RequirePackage[default]{lato}

\pagestyle{empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% Sidebar background: a tinted band on the left of every page.
\newlength{\cv@sidewidth}\setlength{\cv@sidewidth}{6.8 cm}
\AddToShipoutPictureBG{\AtPageLowerLeft{\color{sideColor}\rule{\cv@sidewidth}{\paperheight}}}

% Main column sections: teal title with a thin rule.
\titleformat{\section}{\color{accentColor}\large\bfseries}{}{0pt}{}[{\color{accentColor}\vspace{1pt}\titlerule[0.6pt]}]
\titlespacing{\section}{0pt}{0.32 cm}{0.15 cm}

% ---------------------------------------------------------------------------
% Content macros: the only ones cv.tex should use.
% ---------------------------------------------------------------------------

% \begin{cvpage} sidebar content \cvmain main content \end{cvpage}
\newenvironment{cvpage}{%
  \setcolumnwidth{5.5 cm, \fill}\setlength{\columnsep}{1.3 cm}%
  \begin{paracol}{2}\raggedright
}{%
  \end{paracol}%
}
\newcommand{\cvmain}{\switchcolumn}

% Sidebar
\newcommand{\cvphoto}[1]{%
  {\centering
  \begin{tikzpicture}
    \clip (0,0) circle (1.75 cm);
    \node at (0,0) {\includegraphics[width=3.5 cm]{#1}};
  \end{tikzpicture}\par}\vspace{0.3 cm}}
\newcommand{\sidesection}[1]{%
  \vspace{0.6 cm}{\color{accentColor}\bfseries\MakeUppercase{#1}}\par\nobreak
  \vspace{3pt}{\color{accentColor}\hrule height 0.6pt}\nobreak\vspace{0.2 cm}}
% \cvcontact{fontawesome5 icon name, e.g. Phone, Envelope, MapMarker, LinkedinIn, Car}{text}
\newcommand{\cvcontact}[2]{%
  \mbox{\makebox[0.55 cm][l]{\color{accentColor}\small\csname fa#1\endcsname}}{\small #2}\par\vspace{4pt}}
\newcommand{\cvcontactlink}[3]{\cvcontact{#1}{\href{#2}{#3}}}
\newenvironment{sidelist}{%
  \begin{itemize}[leftmargin=0.38 cm, label={\color{accentColor}\textbullet}, topsep=0pt,
    itemsep=3.5pt, parsep=0pt, partopsep=0pt]
}{\end{itemize}}

% Main column header: \cvname{First LAST}, optional \cvsubname{née NAME}, \cvheadline{job title}
\newcommand{\cvname}[1]{%
  \hypersetup{pdftitle={CV - #1}, pdfauthor={#1}}%
  {\fontsize{24 pt}{26 pt}\selectfont\bfseries #1}\par}
\newcommand{\cvsubname}[1]{\vspace{2pt}{\large\color{mutedColor}#1}\par}
\newcommand{\cvheadline}[1]{\vspace{0.2 cm}{\large\color{accentColor}\bfseries #1}\par\vspace{0.1 cm}}

\newcommand{\cvtext}[1]{#1\par}

% \cventry{Title}{Subtitle or empty}{Organization}{Location}{Dates}
% optionally followed by a cvpoints environment.
\newcommand{\cventry}[5]{%
  \vspace{0.12 cm}%
  \begin{tabularx}{\linewidth}{@{}X@{\hspace{0.3 cm}}r@{}}
    \textbf{#1} & {\small\color{accentColor}\bfseries #5}\\
    \ifthenelse{\equal{#2}{}}{}{#2 & \\}%
    \ifthenelse{\equal{#3#4}{}}{}{{\small\itshape #3} & {\small\color{mutedColor}#4}\\}%
  \end{tabularx}\par}
\newenvironment{cvpoints}{%
  \begin{itemize}[leftmargin=0.4 cm, label={\color{accentColor}\textbullet}, topsep=1pt,
    itemsep=0pt, parsep=0pt]\small
}{\end{itemize}}

% Skill line in the main column: \cvskill{Category}{list}
\newcommand{\cvskill}[2]{\textbf{#1 :} #2\par\vspace{2pt}}

\endinput
