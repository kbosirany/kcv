{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fiche de faits kcv",
  "type": "object",
  "required": ["version", "formations", "experiences", "competences"],
  "additionalProperties": false,
  "$defs": {
    "mois": {"type": ["string", "null"], "pattern": "^[0-9]{4}(-[0-9]{2})?$"},
    "texte": {"type": ["string", "null"]},
    "realisation": {
      "type": "object",
      "required": ["texte"],
      "additionalProperties": false,
      "properties": {
        "texte": {"type": "string"},
        "sous_points": {"type": "array", "items": {"type": "string"}},
        "mots_cles": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "version": {"const": 1},
    "mis_a_jour": {"type": "string"},
    "profil": {"$ref": "#/$defs/texte"},
    "formations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "diplome"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "diplome": {"type": "string"},
          "specialite": {"$ref": "#/$defs/texte"},
          "etablissement": {"$ref": "#/$defs/texte"},
          "lieu": {"$ref": "#/$defs/texte"},
          "debut": {"$ref": "#/$defs/mois"},
          "fin": {"$ref": "#/$defs/mois"},
          "details": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "intitule", "organisation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["emploi", "stage", "benevolat", "autre"]},
          "intitule": {"type": "string"},
          "sous_titre": {"$ref": "#/$defs/texte"},
          "organisation": {"type": "string"},
          "lieu": {"$ref": "#/$defs/texte"},
          "debut": {"$ref": "#/$defs/mois"},
          "fin": {"$ref": "#/$defs/mois"},
          "realisations": {"type": "array", "items": {"$ref": "#/$defs/realisation"}}
        }
      }
    },
    "projets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nom"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "nom": {"type": "string"},
          "contexte": {"$ref": "#/$defs/texte"},
          "lien": {"$ref": "#/$defs/texte"},
          "debut": {"$ref": "#/$defs/mois"},
          "fin": {"$ref": "#/$defs/mois"},
          "realisations": {"type": "array", "items": {"$ref": "#/$defs/realisation"}}
        }
      }
    },
    "competences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["categorie", "elements"],
        "additionalProperties": false,
        "properties": {
          "categorie": {"type": "string"},
          "elements": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "langues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["langue"],
        "additionalProperties": false,
        "properties": {
          "langue": {"type": "string"},
          "niveau": {"$ref": "#/$defs/texte"}
        }
      }
    },
    "a_completer": {"type": "array", "items": {"type": "string"}}
  }
}
